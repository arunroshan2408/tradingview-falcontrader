//@version=6
indicator("FTT Bar Feed", overlay=true)
// 1-minute chart, one alert per symbol. Condition: "Any alert() function call". Webhook URL: https://YOUR-APP/hook
secret = input.string("FTT2025", "Webhook Secret")
alert('{"secret":"' + secret + '","type":"BAR","symbol":"' + syminfo.ticker + '","t":' + str.tostring(time) + ',"o":' + str.tostring(open) + ',"h":' + str.tostring(high) + ',"l":' + str.tostring(low) + ',"c":' + str.tostring(close) + ',"tick":' + str.tostring(syminfo.mintick) + ',"pv":' + str.tostring(syminfo.pointvalue) + '}', alert.freq_once_per_bar_close)
